# Tanova: the company's system. Tours, departures, seats, bookings, enquiries and blog posts all live there.
# Base URL of the API and the company's SECRET key (Tanova > API keys). Server-side only: never prefix with NEXT_PUBLIC_.
TANOVA_API_URL=https://tanovaapp.com/api/v
TANOVA_API_KEY=

# Optional: an extra place enquiries are copied to if Tanova is unreachable.
ENQUIRY_WEBHOOK_URL=
